{
  "name": "fruit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first planner, tracker and reconciler.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "test:core": "cargo test --manifest-path Cargo.toml",
    "check:ui": "node scripts/check-ui.mjs",
    "fixtures": "cargo run -p fruit-core --bin dump-fixtures",
    "test": "cargo test && npm run build && npm run check:ui"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
